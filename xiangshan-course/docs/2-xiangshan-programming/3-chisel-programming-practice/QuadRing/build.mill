//| mill-version: 1.1.2
package build

import mill._
import mill.scalalib._

// Note: This project requires .mill-jvm-opts file containing:
//   -Dchisel.project.root=${PWD}
// This is needed because Chisel needs to know the project root directory
// to properly generate and handle test directories and output files.
// See: https://github.com/com-lihaoyi/mill/issues/3840

// ---------------------------------------------------------------------------
// Single source of truth for the toolchain. Every module must use the same
// Chisel/Scala versions: the main module and `diplomacyLib` share one compile
// classpath, so divergent versions would cause a classpath conflict.
// ---------------------------------------------------------------------------
trait Toolchain extends ScalaModule {
  override def scalaVersion  = "2.13.17"
  def chiselVersion          = "7.13.0"

  override def scalacOptions = Seq(
    "-language:reflectiveCalls",
    "-deprecation",
    "-feature",
    "-Xcheckinit",
    "-Ymacro-annotations",
  )
  override def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:$chiselVersion",
  )
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion",
  )
}

// ---------------------------------------------------------------------------
// The only module you develop in. Put all your designs under `src/main/scala`
// and tests under `src/test/scala`. Diplomacy is available through the
// `diplomacyLib` dependency below.
//
//   import org.chipsalliance.cde.config.Parameters
//   import org.chipsalliance.diplomacy.lazymodule._
//   import org.chipsalliance.diplomacy.nodes._
// ---------------------------------------------------------------------------
object `QuadRing` extends SbtModule with Toolchain {
  // The project root holds `src/`; `super.moduleDir` is `<root>/QuadRing`.
  def moduleDir = super.moduleDir / os.up

  // Bring in the standalone Diplomacy (+ CDE) library.
  override def moduleDeps = super.moduleDeps ++ Seq(diplomacyLib)

  object test extends SbtTests with TestModule.ScalaTest {
    override def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::3.2.19"
    )
  }
}

// ---------------------------------------------------------------------------
// Third-party library module: the extracted `chipsalliance/diplomacy` plus its
// pinned CDE dependency, vendored as source under `third_party/`.
// This is NOT where you write designs -- you only depend on it.
//
// There is no published `org.chipsalliance::diplomacy` artifact on Maven
// Central, so the sources are compiled from the submodules.
// ---------------------------------------------------------------------------

/** Standalone `chipsalliance/diplomacy` + pinned `chipsalliance/cde`. */
object diplomacyLib extends Toolchain {
  override def moduleDir = super.moduleDir / os.up / "third_party"
  override def sources = Task.Sources(
    moduleDir / "diplomacy" / "diplomacy" / "src",
    moduleDir / "cde" / "cde" / "src",
  )
  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.lihaoyi::sourcecode:0.4.2"
  )
}
