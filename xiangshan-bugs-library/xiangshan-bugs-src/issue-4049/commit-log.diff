+  def apply(
+    name         : String,
+    numEntries   : Int,
+    splitNum     : Int,
+    raddr        : Seq[UInt],
+    rdata        : Vec[UInt],
+    wen          : Seq[Bool],
+    waddr        : Seq[UInt],
+    wdata        : Seq[UInt],
+    debugReadAddr: Option[Seq[UInt]],
