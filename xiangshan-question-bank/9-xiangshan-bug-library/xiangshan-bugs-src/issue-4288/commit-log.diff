-      p"cancelled with redirect robIndex 0x${Hexadecimal(io.redirect.bits.robIdx.asUInt)}\n")
-  }
-
-  /**
-   * Part 2: update indices
-   *
-   * tail: (1) enqueue; (2) redirect
-   * head: dequeue
-   */
