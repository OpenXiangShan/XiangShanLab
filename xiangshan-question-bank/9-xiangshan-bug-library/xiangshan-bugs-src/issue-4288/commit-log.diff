-    val enqBypassEnVec = io.enq.needAlloc.zip(enqOffset).map{ case (v, o) => v && enqMatchVec(o) }
-    val enqBypassEn = io.enq.canAccept && VecInit(enqBypassEnVec).asUInt.orR
