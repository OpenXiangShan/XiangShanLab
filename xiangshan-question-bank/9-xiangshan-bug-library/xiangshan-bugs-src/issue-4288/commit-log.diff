-  // find the ones in vector (assumed the vector is not one-hot)
-  def get_ones(vec: Vec[Bool], num: Int, zeros: Int = 0) : (Bool, UInt) = {
-    val vecLeft = vec.drop(zeros)
-    val maskedVec = VecInit(Seq.fill(zeros)(false.B) ++ vecLeft)
